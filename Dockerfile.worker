# Pin the base by digest at build time, e.g. the Sandbox image already pinned in
# app/services/sandbox_bridge/docker_executor.py (IMAGE).
ARG PYTHON_BASE_IMAGE=python:3.12-slim
FROM ${PYTHON_BASE_IMAGE}

ARG ORCHESTRATOR_GIT_SHA
ARG ORCHESTRATOR_BUILD_TIME=unknown
ARG ORCHESTRATOR_IMAGE_TAG=unknown
ARG ORCHESTRATOR_IMAGE_ID=unknown

RUN test -n "${ORCHESTRATOR_GIT_SHA}" \
    && test "${ORCHESTRATOR_GIT_SHA}" != "unknown"

WORKDIR /opt/orchestrator

ENV ORCHESTRATOR_GIT_SHA=${ORCHESTRATOR_GIT_SHA} \
    ORCHESTRATOR_BUILD_TIME=${ORCHESTRATOR_BUILD_TIME} \
    ORCHESTRATOR_IMAGE_TAG=${ORCHESTRATOR_IMAGE_TAG} \
    ORCHESTRATOR_IMAGE_ID=${ORCHESTRATOR_IMAGE_ID} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    WORKER_APP_ROOT=/opt/orchestrator

# The Worker needs Git for the existing workspace/checkpoint lifecycle, CA
# roots for structured HTTP providers, and ripgrep for read-only Discovery
# search_text (fixed argv, shell=False; P43-PRODUCT-23C B2). It does not need
# Node, a Docker client, Redis, Qdrant, or the API image's other CLI tools.
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates git ripgrep \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/orchestrator-worker-requirements.txt
RUN pip install --no-cache-dir -r /tmp/orchestrator-worker-requirements.txt \
    && rm -f /tmp/orchestrator-worker-requirements.txt

# The application release is owned by root and made non-writable. Runtime
# read-only enforcement is supplied by the container run contract as well.
# Git's executable bit is kept (0555 vs 0444) so a git-archive release context
# (scripts/maintenance/p43_c2_worker_release.sh) still recomputes to its
# recorded commit tree and can satisfy the Worker candidate pin without Git.
COPY --chown=root:root . /opt/orchestrator
COPY --chown=root:root scripts/worker-entrypoint.sh /usr/local/bin/orchestrator-worker-entrypoint

RUN groupadd --system --gid 10001 orchestrator-worker \
    && useradd --system --uid 10001 --gid orchestrator-worker \
        --home-dir /nonexistent --no-create-home --shell /usr/sbin/nologin \
        orchestrator-worker \
    && find /opt/orchestrator -type d -exec chmod 0555 {} + \
    && find /opt/orchestrator -type f -perm -u+x -exec chmod 0555 {} + \
    && find /opt/orchestrator -type f ! -perm -u+x -exec chmod 0444 {} + \
    && chmod 0555 /usr/local/bin/orchestrator-worker-entrypoint \
    && install -d -o orchestrator-worker -g orchestrator-worker -m 0700 \
        /var/lib/orchestrator-worker/db \
        /var/lib/orchestrator-worker/runtime \
        /var/lib/orchestrator-worker/checkpoints \
        /var/lib/orchestrator-worker/identity \
        /workspace/authoritative

USER orchestrator-worker

# Discovery's search executable must resolve for the non-root Worker.
RUN rg --version

ENTRYPOINT ["/usr/local/bin/orchestrator-worker-entrypoint"]
