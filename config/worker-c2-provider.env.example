# P43-PRODUCT-23C provider-enabled delta over config/worker-c2-live.env.example.
# Used only by `p43_c2_live_run.sh setup --operator-approved` when
# P43_C2_PROVIDER_UPSTREAM is set; every key here replaces the template's.
#
# Every generation role uses the existing role-owned structured HTTP runtime
# (openai_chat_completions) and resolves to the one disposable relay, reached
# only through the internal network alias `model-provider`. The relay forwards
# exactly GET /v1/models and POST /v1/chat/completions for one approved model
# to one upstream, under one six-completion budget and one deadline. @MODEL@
# is replaced by setup with P43_C2_PROVIDER_MODEL. No API key is configured.
# WORKSPACE_REVIEW_POLICY=hold_all stays in the template (no QA provider call).
AGENT_BACKEND=openai_chat_completions
PLANNING_BACKEND=openai_chat_completions
EXECUTION_BACKEND=openai_chat_completions
DEBUG_REPAIR_BACKEND=openai_chat_completions
REPAIR_BACKEND=openai_chat_completions
COMPLETION_REPAIR_BACKEND=openai_chat_completions
PLANNING_PROVIDER=direct_openai_compatible
LOW_RESOURCE_SINGLE_MODEL=false
AGENT_MODEL=@MODEL@
PLANNER_MODEL=@MODEL@
EXECUTION_MODEL=@MODEL@
PLANNING_DIRECT_MODEL=@MODEL@
PLANNING_REPAIR_MODEL=@MODEL@
DEBUG_REPAIR_MODEL=@MODEL@
COMPLETION_REPAIR_MODEL=@MODEL@
OPENAI_CHAT_COMPLETIONS_MODEL=@MODEL@
OLLAMA_AGENT_MODEL=@MODEL@
PLANNING_DIRECT_BASE_URL=http://model-provider:8000/v1
PLANNING_REPAIR_BASE_URL=http://model-provider:8000/v1
DEBUG_REPAIR_BASE_URL=http://model-provider:8000/v1
OPENAI_CHAT_COMPLETIONS_BASE_URL=http://model-provider:8000/v1
OPENAI_BASE_URL=http://model-provider:8000/v1
OLLAMA_BASE_URL=http://model-provider:8000
# Declared, not discovered: setup refuses to start unless the upstream's
# read-only model list reports max_model_len >= this value.
EXECUTION_CONTEXT_TOKENS=32768
PLANNING_REPAIR_CONTEXT_TOKENS=32768
DEBUG_REPAIR_CONTEXT_TOKENS=32768
