# P43 C2-C3A disposable live-slice Worker contract (one bounded sys.exit(0) run).
# Delta over config/worker.env.example; never the project .env and never secrets.
# CELERY_BROKER_URL / CELERY_RESULT_BACKEND omit credentials. The separate
# CELERY_BROKER_PASSWORD is injected at container start from a root-only Host
# file, not stored in this template or embedded in either URL.

WORKER_ENVIRONMENT=c2-c1-test
WORKER_ISOLATION_MODE=disposable
WORKER_BROKER_NAMESPACE=p43-c2-c1-disposable
WORKER_QUEUE_NAME=orchestrator-c2-c1-test
CELERY_QUEUE_NAME=orchestrator-c2-c1-test

# Production execution stays disabled. Only the exact C2 slice may publish to
# the disposable queue (app/celery_app.py disposable publication admission).
EXECUTION_ENABLED=false
WORKER_BRIDGE_MODE=c2b-sandbox
C2_DISPOSABLE_EXECUTION_ADMISSION=c2-c3-single-sandbox-slice
SANDBOX_BRIDGE_SOCKET=/run/p43-sandbox-bridge-c2/launcher.sock
SANDBOX_BRIDGE_KEY_FILE=/run/secrets/p43-sandbox-bridge-c2.key
WORKER_CONCURRENCY=1
# Hold every result for review: no auto-publication, and the completion-phase
# QA evaluator (a provider call) runs only for auto-promotion.
WORKSPACE_REVIEW_POLICY=hold_all

WORKER_IDENTITY_SOURCE=container-start
CONTROLLED_WORKER_IDENTITY_REQUIRED=true
CONTROLLED_WORKER_NODE_IDENTITY=orchestrator-worker-c2-c1
WORKER_TASK_ALLOWLIST=app.tasks.worker.answer_human_intervention_query,app.tasks.worker.execute_orchestration_task,app.tasks.worker.receive_execution_task_dispatch
WORKER_CANDIDATE_PIN_PATH=/run/secrets/p43-sandbox-bridge-c2-worker-pin.json
WORKER_CANDIDATE_PIN_PROTECTED_ROOT=/var/lib/orchestrator-worker/identity

WORKER_APP_ROOT=/opt/orchestrator
WORKER_SOURCE_ROOT=/opt/orchestrator
WORKER_DATABASE_DIR=/var/lib/orchestrator-worker/db
WORKER_RUNTIME_ROOT=/var/lib/orchestrator-worker/runtime
WORKER_CHECKPOINT_DIR=/var/lib/orchestrator-worker/checkpoints
WORKER_IDENTITY_ROOT=/var/lib/orchestrator-worker/identity
DATABASE_URL=sqlite:////var/lib/orchestrator-worker/db/orchestrator.db
WORKSPACE_ROOT=/workspace/authoritative
RUNTIME_ROOT=/var/lib/orchestrator-worker/runtime
CHECKPOINT_DIR=/var/lib/orchestrator-worker/checkpoints

# Structured HTTP roles only. The internal disposable network has no model
# provider: any provider call fails closed. C2-C3B supplies the accepted plan
# through the stored Task plan, so the success path makes no provider call.
# Every role must still be configured: the Worker validates the execution and
# debug-repair contracts before the claim, and direct_ollama has no
# debug_repair role. The endpoints below are intentionally unreachable.
AGENT_BACKEND=direct_ollama
PLANNING_BACKEND=direct_ollama
EXECUTION_BACKEND=direct_ollama
EXECUTION_MODEL=restricted-test-model
DEBUG_REPAIR_BACKEND=openai_chat_completions
DEBUG_REPAIR_BASE_URL=http://model-provider:11434/v1
DEBUG_REPAIR_MODEL=restricted-test-model
PLANNING_REPAIR_BASE_URL=http://model-provider:11434/v1
PLANNING_REPAIR_MODEL=restricted-test-model
COMPLETION_REPAIR_MODEL=restricted-test-model
REPAIR_BACKEND=direct_ollama
COMPLETION_REPAIR_BACKEND=direct_ollama
PLANNING_PROVIDER=direct_openai_compatible
OLLAMA_BASE_URL=http://model-provider:11434
OLLAMA_AGENT_MODEL=restricted-test-model
PLANNING_REPAIR_CONTEXT_TOKENS=32768
DEBUG_REPAIR_CONTEXT_TOKENS=32768
PLANNING_DIRECT_BASE_URL=http://model-provider:11434/v1
PLANNING_DIRECT_MODEL=restricted-test-model
